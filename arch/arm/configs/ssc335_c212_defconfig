# Minimal bring-up config for the TP-Link Tapo C212 v2
# (SigmaStar SSC335 / Infinity6B0, single Cortex-A7, 64 MiB DDR2).
#
# M1: boot to initramfs with sstar_udp earlycon; no storage/net drivers yet.
# Built with the cross shell in shell.nix at the top of this tree:
#   nix-shell --run 'make O=build-c212 ssc335_c212_defconfig zImage dtbs'
#
# Regenerate with `make savedefconfig` after Kconfig edits (this file is the
# savedefconfig form: only non-default symbols are listed).
CONFIG_BLK_DEV_INITRD=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_ARCH_MSTARV7=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_DEVTMPFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_EARLYCON_SSSTAR_UDP=y
CONFIG_MSTAR_MSC313_UPLL=y
CONFIG_MSTAR_MSC313_PM_MUXES=y
CONFIG_MSTAR_MSC313_CLKGEN=y
CONFIG_MSTAR_MSC313_CLKGEN_GATES=y
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_MSC313E_WATCHDOG=y
CONFIG_TMPFS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_CADENCE=y
CONFIG_MACB=y
CONFIG_PHYLIB=y
CONFIG_OF_MDIO=y
CONFIG_MSC313_PHY=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_CONFIGFS_FS=y
CONFIG_MSTAR_MSC313_SC_GP_CTRL_MUXES=y
# CONFIG_SERIAL_EARLYCON_SSSTAR_UDP_PERSISTENT is not set
