/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/pinctrl-sg2000.h>
#include "sg2000.dtsi"

/ {
	model = "Pine64 Oz64";
	compatible = "pine64,oz64", "sophgo,sg2000";

	aliases {
		mmc0 = &sdhci0;
		mmc1 = &emmc;
		mmc2 = &sdhci1;
		serial0 = &uart0;
		serial4 = &uart4;
	};

	chosen {
		stdout-path = "serial0:1500000n8";
	};

	leds {
		compatible = "gpio-leds";

		blue {
			label = "oz64:blue";
			gpios = <&porta 29 GPIO_ACTIVE_HIGH>;
		};
	};

	/*
	 * CVSNFC SPI NAND controller.  U12 shares the eMMC pads, so this stays
	 * disabled while the eMMC module is the boot medium.  There is no
	 * mainline driver for "cvitek,cv1835-spinf" yet; see
	 * docs/oz64-spi-nand.md in h700-harness-oz64.
	 */
	spinand: spi@4060000 {
		compatible = "cvitek,cv1835-spinf";
		reg = <0x04060000 0x1000>;
		interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk CLK_SPI_NAND>;
		clock-names = "core";
		resets = <&rst RST_SPI_NAND>;
		reset-names = "core";
		bus-width = <4>;
		pinctrl-0 = <&spinand_cfg>;
		pinctrl-names = "default";
		status = "disabled";
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&porta 30 GPIO_ACTIVE_LOW>;
		power-off-delay-us = <50000>;
		post-power-on-delay-ms = <200>;
		pinctrl-0 = <&wifi_pwr_cfg>;
		pinctrl-names = "default";
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "Oz64";
		simple-audio-card,mclk-fs = <256>;
		#address-cells = <1>;
		#size-cells = <0>;

		simple-audio-card,dai-link@0 {
			reg = <0>;
			format = "i2s";
			bitclock-master = <&playback_cpu>;
			frame-master = <&playback_cpu>;

			playback_cpu: cpu {
				sound-dai = <&i2s3>;
				system-clock-frequency = <12288000>;
			};

			codec {
				sound-dai = <&dac>;
			};
		};
	};

	reg_spk_en: regulator-spk-en {
		compatible = "regulator-fixed";
		regulator-name = "spk-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&porta 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		startup-delay-us = <10000>;
		pinctrl-0 = <&spk_en_cfg>;
		pinctrl-names = "default";
	};
};

&osc {
	clock-frequency = <25000000>;
};

/*
 * VDDIO_EMMC is 3.3 V on the Oz64 and is shared by the eMMC, UART0 and
 * AUX0 pin groups.  The pinctrl driver permits one voltage per domain, so
 * all three use 3300; VDDIO_SD1, VDDIO18_1 and VDDIO_RTC are 1.8 V.
 */
&pinctrl {
	emmc_cfg: emmc-cfg {
		emmc-rstn-pins {
			pinmux = <PINMUX(PIN_EMMC_RSTN, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		emmc-clk-pins {
			pinmux = <PINMUX(PIN_EMMC_CLK, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		emmc-cmd-pins {
			pinmux = <PINMUX(PIN_EMMC_CMD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		emmc-data-pins {
			pinmux = <PINMUX(PIN_EMMC_DAT0, 0)>,
				 <PINMUX(PIN_EMMC_DAT1, 0)>,
				 <PINMUX(PIN_EMMC_DAT2, 0)>,
				 <PINMUX(PIN_EMMC_DAT3, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	spinand_cfg: spinand-cfg {
		spinand-pins {
			pinmux = <PINMUX(PIN_EMMC_CLK, 2)>,
				 <PINMUX(PIN_EMMC_CMD, 2)>,
				 <PINMUX(PIN_EMMC_DAT0, 2)>,
				 <PINMUX(PIN_EMMC_DAT1, 2)>,
				 <PINMUX(PIN_EMMC_DAT2, 2)>,
				 <PINMUX(PIN_EMMC_DAT3, 2)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	/*
	 * The microSD socket's SD0_CD pin is wired (100R series + 47k pull-up to
	 * SD_PWR_3V3 on schematic sheet 6).  Mux it to the SDIO0 function so the
	 * controller's card-detect input works even when the bootloader does not
	 * leave it muxed, and so a card inserted after boot is detected.  Same
	 * group as sg2000-milkv-duo-s.dts.
	 */
	sdhci0_cfg: sdhci0-cfg {
		sdhci0-cd-pins {
			pinmux = <PINMUX(PIN_SD0_CD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		sdhci0-clk-pins {
			pinmux = <PINMUX(PIN_SD0_CLK, 0)>;
			bias-pull-up;
			drive-strength-microamp = <16100>;
			power-source = <3300>;
		};

		sdhci0-cmd-pins {
			pinmux = <PINMUX(PIN_SD0_CMD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		sdhci0-data-pins {
			pinmux = <PINMUX(PIN_SD0_D0, 0)>,
				 <PINMUX(PIN_SD0_D1, 0)>,
				 <PINMUX(PIN_SD0_D2, 0)>,
				 <PINMUX(PIN_SD0_D3, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	sdhci1_cfg: sdhci1-cfg {
		sdhci1-clk-pins {
			pinmux = <PINMUX(PIN_SD1_CLK, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <1800>;
		};

		sdhci1-cmd-pins {
			pinmux = <PINMUX(PIN_SD1_CMD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <1800>;
		};

		sdhci1-data-pins {
			pinmux = <PINMUX(PIN_SD1_D0, 0)>,
				 <PINMUX(PIN_SD1_D1, 0)>,
				 <PINMUX(PIN_SD1_D2, 0)>,
				 <PINMUX(PIN_SD1_D3, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <1800>;
		};
	};

	uart0_cfg: uart0-cfg {
		uart0-pins {
			pinmux = <PINMUX(PIN_UART0_TX, 0)>,
				 <PINMUX(PIN_UART0_RX, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	uart4_cfg: uart4-cfg {
		uart4-data-pins {
			pinmux = <PINMUX(PIN_UART2_TX, 5)>,
				 <PINMUX(PIN_UART2_RX, 5)>;
			drive-strength-microamp = <10800>;
			power-source = <1800>;
		};

		uart4-control-pins {
			pinmux = <PINMUX(PIN_UART2_CTS, 5)>,
				 <PINMUX(PIN_UART2_RTS, 5)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <1800>;
		};
	};

	wifi_pwr_cfg: wifi-pwr-cfg {
		wifi-pwr-pins {
			pinmux = <PINMUX(PIN_AUX0, 3)>;
			bias-pull-down;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	spk_en_cfg: spk-en-cfg {
		spk-en-pins {
			pinmux = <PINMUX(PIN_SPK_EN, 3)>;
			bias-pull-down;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};
};

&dmac {
	status = "okay";
};

&emmc {
	/*
	 * The Oz64 eMMC is unreliable at 52 MHz/4-bit: U-Boot takes read
	 * errors at that mode and the live installer must read and write the
	 * user area.  Hardware validated 26 MHz with four data lines: U-Boot
	 * reports Bus Speed 26000000, Bus Width 4-bit, and the existing eMMC
	 * NixOS boots from it.  Keep this capped setting; raise the clock only
	 * after a hardware read/write/erase test at 52 MHz passes.
	 */
	bus-width = <4>;
	cap-mmc-hw-reset;
	max-frequency = <26000000>;
	no-1-8-v;
	no-sd;
	no-sdio;
	non-removable;
	pinctrl-0 = <&emmc_cfg>;
	pinctrl-names = "default";
	status = "okay";
};

&gmac0 {
	/*
	 * The internal ePHY and its MDIO mux are described by the SoC dtsi;
	 * the inherited phy-mode is "internal" and works on this board
	 * (100Mbps/Full, hardware-verified 2026-11-04).
	 */
	status = "okay";
};

&mdio {
	status = "okay";
};

&sdhci0 {
	bus-width = <4>;
	disable-wp;
	no-1-8-v;
	pinctrl-0 = <&sdhci0_cfg>;
	pinctrl-names = "default";
	status = "okay";
};

&sdhci1 {
	bus-width = <4>;
	cap-sdio-irq;
	no-mmc;
	no-sd;
	non-removable;
	max-frequency = <50000000>;
	mmc-pwrseq = <&wifi_pwrseq>;
	pinctrl-0 = <&sdhci1_cfg>;
	pinctrl-names = "default";
	status = "okay";
};

&uart0 {
	pinctrl-0 = <&uart0_cfg>;
	pinctrl-names = "default";
	status = "okay";
};

&uart4 {
	pinctrl-0 = <&uart4_cfg>;
	pinctrl-names = "default";
	uart-has-rtscts;
	status = "okay";
};

/*
 * Reboot on the Oz64.
 *
 * U-Boot resets the board by writing 1 to 0x0300bef0, but that undocumented
 * register does not reset this board when driven from Linux, so it is not
 * used here.  PSCI reset does not reset this board, RTC reset needs the RTC
 * clock, and the watchdog is not used.
 *
 * Use the documented RSTGEN whole-chip reset instead: set sys_ctrl_reg bit 5
 * to enable it, then clear SOFT_RSTN_2 bit 12 to trigger it.  syscon-reboot
 * logs "Unable to restart system" and waits 1 s after each write before
 * returning to the notifier chain, so the enable handler's warning and delay
 * before reboot-trigger resets the board are expected.  reboot-cpuac is a
 * last-resort fallback.
 */
&syscon {
	/*
	 * Whole-chip system soft reset: set sys_ctrl_reg bit 5 to enable the
	 * reset, then clear SOFT_RSTN_2 bit 12 in &rst below.
	 */
	reboot-enable {
		compatible = "syscon-reboot";
		offset = <0x8>;
		mask = <0x20>;
		value = <0x20>;
		priority = <200>;
	};
};

&rst {
	/* Keep the reset-simple compatible first; add syscon for the children. */
	compatible = "sophgo,cv1800b-reset", "syscon", "simple-mfd";

	reboot-trigger {
		compatible = "syscon-reboot";
		offset = <0x8>;
		mask = <0x1000>;
		value = <0x0>;
		priority = <199>;
	};

	/* Documented CPU/CPUSYS reset; the selected bits auto-clear. */
	reboot-cpuac {
		compatible = "syscon-reboot";
		offset = <0x20>;
		mask = <0x7f>;
		value = <0x0>;
		priority = <198>;
	};
};

&{/soc} {
	i2s3: i2s@4130000 {
		compatible = "sophgo,cv1800b-i2s";
		reg = <0x04130000 0x1000>;
		clocks = <&clk CLK_APB_I2S3>, <&clk CLK_SDMA_AUD3>;
		clock-names = "i2s", "mclk";
		dmas = <&dmamux 7 0>;
		dma-names = "tx";
		#sound-dai-cells = <0>;
		status = "okay";
	};

	dac: audio-codec@300a000 {
		compatible = "sophgo,cv1800b-sound-dac";
		reg = <0x0300a000 0x100>;
		#sound-dai-cells = <0>;
		status = "okay";
	};
};

&usb {
	/* VBUS power is handled by the in-tree cv1800b USB2 PHY driver. */
	dr_mode = "host";
	status = "okay";
};
